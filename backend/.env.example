# KSP-CIP configuration. Every variable is optional: the platform runs with
# zero credentials using local deterministic providers.
# Copy to backend/.env and edit only what you need.

# ---------------------------------------------------------------- runtime
KSPCIP_ENVIRONMENT=local              # local | catalyst | production
KSPCIP_DEBUG=false
KSPCIP_API_PREFIX=/api/v1
KSPCIP_LOG_LEVEL=INFO
KSPCIP_LOG_JSON=true

# -------------------------------------------------------------- datastore
# Each backend is an independent switch. Startup refuses an incoherent
# combination (e.g. a Catalyst data store with a local file store: exports on a
# function filesystem do not survive a cold start).
KSPCIP_DATASTORE_BACKEND=sqlite       # sqlite | catalyst
KSPCIP_FILESTORE_BACKEND=local        # local | catalyst
KSPCIP_IDENTITY_BACKEND=local         # local | catalyst
KSPCIP_GRAPH_BACKEND=networkx         # networkx | neo4j
KSPCIP_SQLITE_PATH=backend/var/ksp_cip.db
KSPCIP_FILESTORE_ROOT=backend/var/filestore

# Optional graph backend. Self-hosted (a Docker container is enough); the
# platform falls back to NetworkX automatically if it is unreachable.
# CHANGE THE PASSWORD if you enable this.
# KSPCIP_NEO4J_URI=bolt://localhost:7687
# KSPCIP_NEO4J_USER=neo4j
# KSPCIP_NEO4J_PASSWORD=

# --------------------------------------------------------------- security
# CHANGE THIS before any deployment. The default is a development placeholder
# and the platform logs a warning when it is left in place.
KSPCIP_JWT_SECRET=dev-only-secret-change-me
KSPCIP_ACCESS_TOKEN_TTL_SECONDS=43200
KSPCIP_PASSWORD_HASH_ITERATIONS=120000

# -------------------------------------------------------------------- LLM
# `local` is a deterministic, offline provider: it composes narrative only
# from facts the deterministic layer already computed, and invents nothing.
# Set a hosted provider only if you want more fluent phrasing; it cannot
# change any figure, citation or provenance marker (see ADR-0003).
KSPCIP_LLM_PROVIDER=local             # local | anthropic | gemini | groq | openai_compatible
KSPCIP_LLM_MODEL=local-deterministic-v1
# KSPCIP_LLM_API_KEY=
# KSPCIP_LLM_BASE_URL=
KSPCIP_LLM_TEMPERATURE=0.1
KSPCIP_LLM_DAILY_TOKEN_BUDGET=2000000

# --------------------------------------------------------------- language
# `local` uses an offline Kannada glossary and reports itself as not
# full-fidelity. Configure Bhashini for real translation, ASR and TTS.
KSPCIP_LANGUAGE_PROVIDER=local        # local | bhashini | ai4bharat
# KSPCIP_BHASHINI_USER_ID=
# KSPCIP_BHASHINI_API_KEY=
# KSPCIP_BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# AI4Bharat is SELF-HOSTED: there is no vendor account and no API key. The only
# required setting is the URL of the speech-service/ instance you run, which
# needs a GPU rather than a credential. See docs/voice-ai4bharat.md.
# KSPCIP_AI4BHARAT_BASE_URL=http://127.0.0.1:9100

# --------------------------------------------------------------- Catalyst
# CATALYST_PROJECT_ID is also read by catalyst.json at deploy time.
# KSPCIP_CATALYST_PROJECT_ID=
# KSPCIP_CATALYST_ENVIRONMENT=Development
# KSPCIP_CATALYST_BASE_URL=https://api.catalyst.zoho.in
# KSPCIP_CATALYST_ACCOUNTS_URL=https://accounts.zoho.in
# KSPCIP_CATALYST_OAUTH_CLIENT_ID=
# KSPCIP_CATALYST_OAUTH_CLIENT_SECRET=
# KSPCIP_CATALYST_OAUTH_REFRESH_TOKEN=
# KSPCIP_CATALYST_STRATUS_BUCKET=cip-ingest

# Zoho accounts are data-centre-scoped and the defaults above are the INDIA DC.
# If the project lives elsewhere, override BOTH urls together (.com US, .eu EU)
# or token refresh fails with a confusing invalid_client.

# Required only when KSPCIP_IDENTITY_BACKEND=catalyst. Role and scope are always
# read from cip_user_account, never from a token claim.
# KSPCIP_CATALYST_AUTH_ISSUER=
# KSPCIP_CATALYST_AUTH_AUDIENCE=

# -------------------------------------------------------------- analytics
KSPCIP_SYNTHETIC_SEED=20260725
KSPCIP_RAG_TOP_K=8
KSPCIP_RAG_MIN_SIMILARITY=0.18
KSPCIP_HOTSPOT_GRID_METRES=750
KSPCIP_HOTSPOT_MIN_CASES=5
KSPCIP_EARLY_WARNING_SIGMA=2.0
KSPCIP_ENTITY_RESOLUTION_TAU_HIGH=0.90
KSPCIP_ENTITY_RESOLUTION_TAU_LOW=0.72
KSPCIP_AUDIT_RETENTION_DAYS=2557

# Deployment settings for the Catalyst-hosted API.
#
# Copy to `catalyst/deploy.env` (gitignored) and fill in real values. The
# build script merges this into the staged app-config.json's env_variables,
# so the deployed service carries them and a redeploy cannot silently drop
# values someone typed into the Catalyst console.
#
# Never commit the filled-in file. Values are printed by name only, never
# by value, during a build.

# --- Which backends the deployed API binds -----------------------------
# Removing the local/sqlite overrides is what actually moves the deployment
# onto Catalyst-hosted persistence.
KSPCIP_ENVIRONMENT=development
KSPCIP_DATASTORE_BACKEND=catalyst
KSPCIP_FILESTORE_BACKEND=catalyst

# --- Catalyst project --------------------------------------------------
KSPCIP_CATALYST_PROJECT_ID=54586000000013047
KSPCIP_CATALYST_ENVIRONMENT=Development
KSPCIP_CATALYST_STRATUS_BUCKET=cip-ingest

# --- OAuth self-client (Zoho API Console, .in data centre) -------------
# Scopes required by the adapters:
#   ZohoCatalyst.zcql.CREATE          reads  (POST /query)
#   ZohoCatalyst.tables.rows.ALL      writes (POST /table/{id}/row)
#   ZohoCatalyst.tables.ALL           table metadata
#   ZohoCatalyst.tables.bulk.READ/CREATE
#   Stratus.fileop.ALL, Stratus.bucketop.ALL   object storage
KSPCIP_CATALYST_OAUTH_CLIENT_ID=
KSPCIP_CATALYST_OAUTH_CLIENT_SECRET=
KSPCIP_CATALYST_OAUTH_REFRESH_TOKEN=

# --- Application secrets ----------------------------------------------
# Startup refuses the development placeholder outside the `local`
# environment. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KSPCIP_JWT_SECRET=
